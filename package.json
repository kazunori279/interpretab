{
  "name": "interpretab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that interprets tab audio and your microphone in real time via the Gemini Live API.",
  "scripts": {
    "test": "node --test 'tests/**/*.test.js'",
    "package": "zip -r interpretab.zip . -x '.git/*' 'store/*' 'tests/*' 'node_modules/*' 'package.json' 'README.md' 'index.md' '_config.yml' '_data/*' '_includes/*' '_layouts/*' 'ar/*' 'de/*' 'es/*' 'fr/*' 'hi/*' 'ja/*' 'ko/*' 'pt/*' 'zh/*' '*.zip' '.*'"
  }
}
